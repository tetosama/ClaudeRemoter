{
  "name": "claude-remoter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "NODE_ENV=development tsx watch src/server/index.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "npm run build && NODE_ENV=production node dist/src/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:server": "tsx scripts/e2e-server.ts",
    "smoke:real": "tsx scripts/real-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.247",
    "@fastify/cookie": "11.0.2",
    "@fastify/middie": "9.3.3",
    "@fastify/multipart": "9.2.1",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.2.0",
    "better-sqlite3": "12.2.0",
    "chokidar": "4.0.3",
    "fastify": "5.12.1",
    "katex": "^0.16.22",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "^6.0.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "27.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "6.1.0",
    "vitest": "3.0.8"
  }
}
